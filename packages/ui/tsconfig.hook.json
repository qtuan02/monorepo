{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,

    /**
     * A third cache file, for the same reason as `tsconfig.build.json` — and
     * distinct from it because rslib compiles the two libs in parallel.
     */
    "tsBuildInfoFile": "${configDir}/.cache/tsbuildinfo.hook.json",
    "declaration": true,
    "allowImportingTsExtensions": false,
    "rootDir": "../hook/src"
  },
  "include": ["../hook/src"],
  "exclude": ["node_modules"]
}
