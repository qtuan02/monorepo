{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,

    /**
     * A third cache file, for the same reason as `tsconfig.build.json` — and
     * distinct from it because rslib compiles the two libs in parallel.
     */
    "tsBuildInfoFile": "${configDir}/.cache/tsbuildinfo.hook.json",
    "declaration": true,
    "allowImportingTsExtensions": false,
    "rootDir": "../hook/src"
  },
  /**
   * The same two files `rslib.config.ts` lists as the `internal` entry —
   * tsgo emits a `.d.ts` for everything included here, not only for the
   * entries, so a directory would ship declarations for hooks with no `.js`.
   */
  "include": ["../hook/src/use-is-mobile.ts", "../hook/src/use-media-query.ts"],
  "exclude": ["node_modules"]
}
