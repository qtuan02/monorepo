{
  "name": "@fe-monorepo/ui",
  "version": "1.0.2",
  "description": "63 shadcn primitives in the base-vega style, built on Base UI — subpath-only, ESM, React 19, Tailwind v4.",
  "keywords": [
    "react",
    "react-19",
    "base-ui",
    "shadcn",
    "tailwindcss",
    "ui-components",
    "typescript"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./dist/globals.css"
  ],
  "homepage": "https://github.com/qtuan02/monorepo/tree/main/packages/ui-public",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qtuan02/monorepo.git",
    "directory": "packages/ui-public"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js"
    },
    "./utils/*": {
      "types": "./dist/utils/*.d.ts",
      "import": "./dist/utils/*.js"
    },
    "./globals.css": "./dist/globals.css"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@shadcn/react": "^0.3.1",
    "@tanstack/react-table": "^9.2.4",
    "class-variance-authority": "0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "1.40.0",
    "react-day-picker": "^10.0.1",
    "react-resizable-panels": "^4.12.3",
    "recharts": "3.8.0",
    "tailwind-merge": "^3.6.0",
    "tailwind-scrollbar": "4.0.2",
    "tw-animate-css": "1.4.0"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19",
    "tailwindcss": "^4"
  }
}
