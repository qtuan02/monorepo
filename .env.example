# Copy to `.env` at the repo root and fill in your own values. `.env` is
# gitignored. Two client prefixes (PUBLIC_, NEXT_PUBLIC_) plus one unprefixed
# server group — nothing maps one onto another, so a value shared by more than
# one Runtime is spelled twice (ADR-0003, ADR-0006). Ports live in each app's
# own `apps/<app>/ports.env`, never here — `*_BASE_DOMAIN` is the origin an app
# is built against, not the port it binds.
#
# A key every app of a Runtime reads keeps the plain name. A key only one app
# reads carries that app's name — `TEMPLATE_VITE` / `TEMPLATE_NEXT` /
# `TEMPLATE_REACTROUTER` for the three Template apps.

# --- PUBLIC_* — Vite Runtime + React Router Runtime's client block ---------

# apps/_template_vite, apps/_template_reactrouter, apps/documents, apps/smart-rental
PUBLIC_APP_ENV=local
PUBLIC_BASE_DOMAIN=http://localhost:3000
PUBLIC_BASE_DOMAIN_API=http://localhost:8000

# apps/documents — every primitive/hook page builds its demo link from this. Required.
PUBLIC_DOCUMENTS_STORYBOOK_URL=https://storybook-monorepo-ui.vercel.app

# --- NEXT_PUBLIC_* — Next Runtime (t3-env) ----------------------------------

# apps/_template_next, apps/portfolio, apps/mcp-weather
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_BASE_DOMAIN_API=http://localhost:8000

# apps/_template_next — empty = Sentry SDK installed but disabled.
NEXT_PUBLIC_TEMPLATE_NEXT_SENTRY_DSN=

# apps/portfolio — empty = Sentry SDK installed but disabled.
NEXT_PUBLIC_PORTFOLIO_SENTRY_DSN=

# apps/portfolio — metadataBase/robots.ts/sitemap.ts build absolute URLs from this. Required.
NEXT_PUBLIC_PORTFOLIO_BASE_DOMAIN=http://localhost:3002

# apps/mcp-weather — empty = Sentry SDK installed but disabled.
NEXT_PUBLIC_MCP_WEATHER_SENTRY_DSN=

# --- Server-only — no prefix, never inlined by either bundler --------------

# apps/_template_reactrouter — signs the session cookie. Required.
TEMPLATE_REACTROUTER_SESSION_SECRET=dev-only-session-secret-change-me

# apps/mcp-weather — signs get-weather/get-forecast. Required; get a key at
# https://openweathermap.org/api.
MCP_WEATHER_OPENWEATHERMAP_API_KEY=replace-with-your-openweathermap-key
