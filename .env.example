# Copy this file to `.env` at the repo root and adjust the values for your
# machine. `.env` is gitignored — every developer/environment keeps their own.
#
# One file, two prefixes: each Runtime keeps the prefix its bundler inlines
# (ADR-0003). Nothing maps one group onto the other — a value shared by both
# Runtimes is spelled twice, on purpose.

# ---------------------------------------------------------------------------
# PUBLIC_* — read by a Vite app through `import.meta.env`, validated by
# `@monorepo/env/vite/*` (`createEnv(baseEnvSchema, import.meta.env)`).
# ---------------------------------------------------------------------------
PUBLIC_APP_ENV=local
PUBLIC_BASE_DOMAIN=http://localhost:3000
PUBLIC_BASE_DOMAIN_API=http://localhost:8000

# ---------------------------------------------------------------------------
# NEXT_PUBLIC_* — read by a Next app through `@monorepo/env/next/*` (t3-env).
# `next dev`/`next build` only reads a `.env` inside the app directory, so the
# app's own scripts load this one with `dotenv -e ../../.env --` first.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_BASE_DOMAIN=http://localhost:3001
NEXT_PUBLIC_BASE_DOMAIN_API=http://localhost:8000

# Sentry project DSN. Empty means the SDK stays installed but disabled — no
# network, no console noise (see packages/sentry/src/options.ts). Both the
# browser and the server SDK read this one inlined value, so it carries the
# client prefix even though the server uses it too.
NEXT_PUBLIC_SENTRY_DSN=

# ---------------------------------------------------------------------------
# Server-only variables carry NO prefix — Next keeps them out of the browser
# bundle and t3-env reads them straight from `process.env`. An app declares its
# own under `server` in its `env.ts`, and adds it here with a dev value (see
# packages/env/README.md).
# ---------------------------------------------------------------------------

# Declared by apps/_template_next/src/env.ts, and `.optional()` there because
# the template has no backend to authenticate against — so it stays commented
# out and a fresh clone still builds. A real app drops the `.optional()` and
# fills this in.
# TEMPLATE_API_TOKEN=
