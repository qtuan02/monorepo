{
  "extends": "@monorepo/tsconfig/base.json",
  "compilerOptions": {
    "lib": ["ES2022", "dom", "dom.iterable"],
    // tsgo 7 does not auto-include node_modules/@types, so `node` is named
    // explicitly for the config files; `vite/client` types `import.meta.env`,
    // which `src/env.ts` reads.
    "types": ["node", "vite/client"],
    "jsx": "react-jsx",
    // `react-router typegen` writes `.react-router/types/<path>/+types/<route>.d.ts`,
    // mirroring the source tree. `rootDirs` merges the two trees into one
    // virtual directory, which is what makes a route module's
    // `import type { Route } from "./+types/home"` resolve.
    "rootDirs": [".", "./.react-router/types"],
    "paths": {
      "~/*": ["./src/*"]
    }
  },
  // `.react-router/types` is generated by `react-router typegen`, which
  // `typecheck` runs first — the order is load-bearing, since `tsc` on a clean
  // clone would otherwise fail on every `./+types/…` import.
  "include": [
    "src",
    "test",
    "e2e",
    "ports.ts",
    "react-router.config.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "vitest.setup.ts",
    "playwright.config.ts",
    ".react-router/types/**/*"
  ],
  "exclude": ["node_modules", "build"]
}
