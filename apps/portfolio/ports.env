# The two ports this app listens on, and the only place either number is
# written. `ports.ts` beside this file reads them for `playwright.config.ts`;
# the `dev` and `start` scripts in package.json hand this file to dotenv-cli,
# which puts `PORT` in the environment `next dev` / `next start` read.
# `turbo/generators/config.ts` rewrites these two lines when it clones the app,
# so a generated app runs beside the Template it came from.
#
# A dotenv file rather than a TS module because Next has no config-level port
# option: `next.config.ts` can import a module but has nowhere to put the value,
# and the only two channels into the CLI are a `--port` flag and `PORT`. This is
# the one file shape both a package.json script and a TypeScript config can
# read, which is why the Vite Template carries the same one.
#
# Not app config. It is not named `.env*`, so Next never loads it as one — app
# config is still the repo-root `.env` (ADR-0003), loaded by the second `-e`.
#
# Ports are allocated one pair per app — dev 3000+n, e2e 3100+n. `apps/storybook`
# is deliberately outside the bands on Storybook's own 6006 and has no E2E
# server, so it declares no `ports.env`.
PORT=3002
# One hundred above the dev port, so a forgotten `next dev` can never answer an
# E2E run: `reuseExistingServer` would hand those specs the dev server's module
# graph and the run would still look green.
E2E_PORT=3102
