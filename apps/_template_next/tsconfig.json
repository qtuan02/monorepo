{
  "extends": "@monorepo/tsconfig/base.json",
  "compilerOptions": {
    "lib": ["ES2022", "dom", "dom.iterable"],
    // tsgo 7 does not auto-include node_modules/@types, so `node` is named
    // explicitly for the config files and the build-time modules.
    "types": ["node"],
    "jsx": "preserve",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // Editor-only: powers Next's own diagnostics in an IDE. `tsc` ignores it.
    "plugins": [{ "name": "next" }],
    "paths": {
      "~/*": ["./src/*"]
    }
  },
  // `.next/types` is generated by `next typegen` (which `typecheck` runs first)
  // and holds `PageProps`/`LayoutProps` plus the `next/root-params` getters, so
  // a route module's props and `locale()` are typed from the real route tree.
  "include": [
    "next-env.d.ts",
    "src",
    "test",
    "e2e",
    "next.config.ts",
    "playwright.config.ts",
    "postcss.config.mjs",
    "vitest.config.ts",
    "vitest.setup.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
