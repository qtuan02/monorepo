{
  "name": "@monorepo/documents",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "generate:docs-metadata": "bun scripts/generate-docs-metadata.ts",
    "predev": "bun scripts/generate-docs-metadata.ts",
    "dev": "vite",
    "prebuild": "bun scripts/generate-docs-metadata.ts",
    "build": "vite build",
    "preview": "vite preview",
    "pretypecheck": "bun scripts/generate-docs-metadata.ts",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "pretest": "bun scripts/generate-docs-metadata.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:coverage": "bun scripts/generate-docs-metadata.ts",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test --project=chromium",
    "e2e:headed": "playwright test --project=watch --headed --workers=1"
  },
  "dependencies": {
    "@monorepo/dayjs": "workspace:*",
    "@monorepo/env": "workspace:*",
    "@monorepo/hook": "workspace:*",
    "@monorepo/i18n": "workspace:*",
    "@monorepo/ui": "workspace:*",
    "lucide-react": "catalog:",
    "react": "catalog:react19",
    "react-dom": "catalog:react19",
    "react-error-boundary": "catalog:",
    "react-i18next": "catalog:",
    "react-router": "catalog:react-router8"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@monorepo/tailwind-config": "workspace:*",
    "@monorepo/tsconfig": "workspace:*",
    "@playwright/test": "catalog:testing",
    "@rolldown/plugin-babel": "catalog:",
    "@tailwindcss/vite": "catalog:tailwind4",
    "@testing-library/jest-dom": "catalog:testing",
    "@testing-library/react": "catalog:testing",
    "@testing-library/user-event": "catalog:testing",
    "@types/babel__core": "^7.20.5",
    "@types/node": "catalog:",
    "@types/react": "catalog:react19",
    "@types/react-dom": "catalog:react19",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "catalog:testing",
    "babel-plugin-react-compiler": "catalog:",
    "jsdom": "catalog:testing",
    "oxc-parser": "catalog:",
    "tailwind-scrollbar": "catalog:tailwind4",
    "tailwindcss": "catalog:tailwind4",
    "tw-animate-css": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:testing"
  }
}
